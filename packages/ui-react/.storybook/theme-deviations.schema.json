{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Accepted theme-profile deviations",
  "type": "object",
  "additionalProperties": false,
  "required": ["deviations"],
  "properties": {
    "$schema": { "type": "string" },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["story", "profiles", "reason", "approvedBy", "date"],
        "properties": {
          "story": {
            "type": "string",
            "description": "Storybook story id, e.g. widgets-chart--default."
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "system-dark",
                "system-light",
                "forced-light",
                "forced-dark"
              ]
            },
            "description": "Non-baseline profiles under which this story is KNOWN to differ."
          },
          "reason": { "type": "string", "minLength": 10 },
          "approvedBy": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "expires": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "issue": { "type": "string" }
        }
      }
    }
  }
}
